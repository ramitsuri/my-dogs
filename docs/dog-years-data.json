      }
    },
    "giant": {
      "label": "Giant",
      "weightRangeLb": [91, null],
      "defaultLifespanYears": 8,
      "lifeStageChart": {
        "agePoints":  [0, 1, 2, 3, 5, 8, 10, 12, 15],
        "humanYears": [0, 12, 22, 31, 42, 64, 78, 96, 110]
      }
    }
  },
